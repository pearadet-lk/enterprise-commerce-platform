<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Commerce Identity</title>
    <style>
        body { font-family: Segoe UI, sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; }
        .container { max-width: 420px; margin: 10vh auto; padding: 2rem; background: #1e293b; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,.35); }
        h1 { margin-top: 0; font-size: 1.5rem; }
        label { display: block; margin-top: 1rem; font-size: .9rem; color: #94a3b8; }
        input[type=text], input[type=password] { width: 100%; box-sizing: border-box; margin-top: .35rem; padding: .65rem .75rem; border: 1px solid #334155; border-radius: 8px; background: #0f172a; color: #e2e8f0; }
        button { margin-top: 1.25rem; width: 100%; padding: .75rem; border: 0; border-radius: 8px; background: #2563eb; color: white; font-weight: 600; cursor: pointer; }
        .alert { background: #7f1d1d; padding: .75rem; border-radius: 8px; margin-bottom: 1rem; }
        a { color: #93c5fd; }
    </style>
</head>
<body>
    <div class="container login-page">
        @RenderBody()
    </div>
</body>
</html>
